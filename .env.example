# Server-side only. Nuxt maps these onto runtimeConfig.weatherApiKey /
# runtimeConfig.weatherApiBase, which are read by server/api/*.get.js and never sent
# to the browser.

# Required — get one from https://www.weatherapi.com/
NUXT_WEATHER_API_KEY=

# Optional. Defaults to https://api.weatherapi.com/v1 (see nuxt.config.js); override
# to point the Nitro routes at a mock or a proxy.
NUXT_WEATHER_API_BASE=https://api.weatherapi.com/v1
